<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/newsListFragment">

    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.news.ui.MainActivity"
        android:label="activity_main"
        tools:layout="@layout/activity_main" />
    <fragment
        android:id="@+id/newsListFragment"
        android:name="com.example.news.ui.newslist.NewsListFragment"
        android:label="NewsListFragment" />
    <fragment
        android:id="@+id/savedNewsFragment"
        android:name="com.example.news.ui.newslist.SavedNewsFragment"
        android:label="Saved News"
        tools:layout="@layout/saved_list_fragment" />
    <fragment
        android:id="@+id/splashScreenFragment"
        android:name="com.example.news.ui.splashscreen.SplashScreenFragment"
        android:label="SplashScreenFragment" >
        <action
            android:id="@+id/action_splashScreenFragment_to_newsListFragment"
            app:destination="@id/newsListFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim" />
    </fragment>
</navigation>